# /etc/systemd/system/usbguard-web.service
# ════════════════════════════════════════════════════════════════════════
# USBGuard Approval Manager – Web Interface
# Systemd Unit – Hardened Service Definition
# Version: 2.3 (Production Ready)
# ════════════════════════════════════════════════════════════════════════

[Unit]
Description=USBGuard Approval Manager - Web Interface
Documentation=https://github.com/usbguard/usbguard-manager

# תלות בשירותי ליבה
Requires=usbguard.service usbguard-network-lockdown.service
After=network.target usbguard.service usbguard-network-lockdown.service

# רשת חייבת להיות זמינה לחלוטין
After=network-online.target
Wants=network-online.target

# הפעלת TTL Reaper באופן קבוע
Wants=usbguard-ttl-reaper.timer

[Service]
Type=simple
User=root
Group=usbadmins
WorkingDirectory=/etc/usbguard/web

# בדיקת מוכנות לפני עלייה
ExecStartPre=/etc/usbguard/scripts/healthcheck.sh --ready

# הפעלת ה־Web Server
ExecStart=/etc/usbguard/web/start-web.sh
ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60

StandardOutput=journal
StandardError=journal

# ───────────────────────────────────────────────────────────────────────
# Security Hardening
# ───────────────────────────────────────────────────────────────────────
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
PrivateTmp=true

# הרשאות רשת נדרשות
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# סינון קריאות מערכת
SystemCallFilter=@system-service

# יכולת לפתוח פורטים (80/443)
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# נתיבים מותרים לכתיבה
ReadWritePaths=/etc/usbguard /var/lib/usbguard-manager /var/log /var/tmp /run

# מניעת hang בעת כיבוי
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target