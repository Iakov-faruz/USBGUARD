# ════════════════════════════════════════════════════════════════════════
# USBGuard TTL Reaper Timer
# Systemd Timer – Run TTL Cleanup Every 5 Minutes
# Version: 2.2 (Production Ready)
# ════════════════════════════════════════════════════════════════════════
#
# תפקיד הטיימר:
#   הפעלה אוטומטית של שירות ה־TTL Reaper כל 5 דקות
#   כדי למחוק Temporary Rules שפג תוקפם.
#
# מאפיינים:
#   - ריצה ראשונית 2 דקות לאחר עליית המערכת
#   - ריצה מחזורית כל 5 דקות
#   - תמיכה ב־Persistent (משלים ריצות שהוחמצו)
#   - עיכוב אקראי למניעת עומסים
#
# ════════════════════════════════════════════════════════════════════════

[Unit]
Description=Run USBGuard TTL Reaper every 5 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
Persistent=true
AccuracySec=1s
RandomizedDelaySec=30s

[Install]
WantedBy=timers.target
